{
  "name": "saucedemo-cypress-testing",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end testing of the existing SauceDemo demo e-commerce website using Cypress.",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:chrome": "cypress run --browser chrome",
    "cy:report": "cypress run --reporter junit --reporter-options \"mochaFile=cypress/results/junit-[hash].xml,toConsole=true\""
  },
  "devDependencies": {
    "cypress": "^15.0.0",
    "mocha-junit-reporter": "^2.2.1"
  }
}
